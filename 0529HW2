<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<title>MindAR 影片播放互動</title>

<!-- 載入 A-Frame 和 MindAR -->
<script src="https://cdn.jsdelivr.net/npm/aframe@1.4.2/dist/aframe.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

<style>
body {
  margin: 0;
  overflow: hidden;
}
</style>
</head>

<body>

<!-- A-Frame 場景設定 -->
<a-scene
  mindar-image="
    imageTargetSrc: targets.mind;
    autoStart: true;
    uiLoading: true;
    uiError: true;
    uiScanning: true;
  "
  color-space="sRGB"
  renderer="colorManagement: true; physicallyCorrectLights: true"
  vr-mode-ui="enabled: false"
  device-orientation-permission-ui="enabled: false"
>

  <!-- 載入影片 -->
  <a-assets>
    <video
      id="introVid"
      src="video.mp4"
      preload="auto"
      loop
      muted
      playsinline
      webkit-playsinline
      crossorigin="anonymous">
    </video>
  </a-assets>

  <!-- 環境光 -->
  <a-light type="ambient" intensity="2"></a-light>

  <!-- 相機 -->
  <a-camera look-controls="enabled: false"></a-camera>

  <!-- AR 標記 -->
  <a-entity id="marker" mindar-image-target="targetIndex: 0">

    <a-video
      id="videoEntity"
      src="#introVid"
      width="1.2"
      height="0.7"
      position="0 0 0"
      autoplay="false"
      loop="true"
      material="shader: flat">
    </a-video>

  </a-entity>

</a-scene>

<script>

const video = document.querySelector("#introVid");
const target = document.querySelector("#marker");
const videoPlane = document.querySelector("#videoEntity");

/* 點擊影片暫停 / 播放 */
videoPlane.addEventListener("click", () => {

  if (video.paused) {
    video.play();
  } else {
    video.pause();
  }

});

/* 掃描到標記 */
target.addEventListener("targetFound", () => {

  video.currentTime = 0;
  video.play();

});

/* 離開標記 */
target.addEventListener("targetLost", () => {

  video.pause();
  video.currentTime = 0;

});

</script>

</body>
</html>
